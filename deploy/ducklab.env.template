# DuckLab Operations — production environment
#
# Loaded by ducklab.service via systemd EnvironmentFile.
# Install to /etc/ducklab/ducklab.env with permissions 0640 root:ducklab.
#
# NEVER commit real values or secrets. This file contains only safe defaults.
# There are no secrets in DuckLab config today (session tokens are random and
# server-side validated); keep it that way.

# --- Persistent database location (REQUIRED in production) ---
# Independent of the build tree, writable by the service user, not web-served.
DUCKLAB_DB_PATH=/var/lib/ducklab/store_ops.db

# --- Cookie / transport security (REQUIRED in production behind HTTPS) ---
# Marks the session cookie Secure so browsers only send it over HTTPS.
DUCKLAB_SECURE_COOKIES=1
# Honor X-Forwarded-For only from the trusted loopback proxy (Caddy).
# Correct client IPs feed the login rate limiter and audit logs.
DUCKLAB_TRUST_PROXY=1

# --- Dev-only origin allowance. MUST be empty/unset in production. ---
# DUCKLAB_FRONTEND_ORIGINS=
