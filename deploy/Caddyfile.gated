# DuckLab Operations — production Caddy configuration with TEMPORARY
# PUBLIC-ACCESS GATE (IP allowlist with HTTP Basic-auth fallback).
#
# This config is installed and Caddy is reloaded BEFORE the DuckLab service is
# started on 127.0.0.1:3000, so the application is never publicly exposed
# without the gate in front of it.
#
# Gate behavior:
#   - Clients connecting from the operator allowlist IP(s) pass through.
#   - All other clients receive an HTTP 401 Basic Auth challenge
#     (WWW-Authenticate: Basic realm="restricted"); a valid "operator"
#     credential grants access. (Non-allowlisted clients get 401, NOT 403.)
#
# Validate:   caddy validate --config /path/to/this/file
# Apply:      install over /etc/caddy/Caddyfile (previous version is backed up
#             by the installer), then `systemctl reload caddy`.
# Rollback:   reinstall the backed-up Caddyfile and `systemctl reload caddy`.
#
# REMOVE THE GATE (the @blocked matcher + basic_auth block) only after explicit
# operator approval for public cutover.
#
# NOTE on the client IP: this host terminates TLS directly (server: Caddy; no
# CDN/Cloudflare in front), so Caddy's `remote_ip` is the real connecting
# client IP. If a CDN is ever placed in front, switch the matcher to use the
# trusted forwarded header instead and restrict `trusted_proxies`.

app.theducklab.com {
	# --- TEMPORARY MAINTENANCE GATE -------------------------------------
	# @blocked matches any client NOT in the operator IP allowlist.
	@blocked not remote_ip __OPERATOR_IP_CIDR__

	# Basic-auth fallback for non-allowlisted clients (e.g. a dynamic
	# operator IP). bcrypt hash; the plaintext credential is never stored.
	# The real hash is injected by the installer (generated with
	# `caddy hash-password`). This placeholder is intentionally invalid so
	# the gate fails CLOSED if the file is installed without substitution.
	basic_auth @blocked {
		operator __OPERATOR_BCRYPT_HASH__
	}

	# --- Application upstream (single-port Reflex) -----------------------
	# granian serves the compiled frontend, /api/*, the /_event WebSocket,
	# and static assets together on 127.0.0.1:3000. The WebSocket upgrade
	# and X-Forwarded-For/Proto/Host headers pass through automatically.
	reverse_proxy 127.0.0.1:3000

	# Defensive request ceiling; Reflex has no large uploads.
	request_body {
		max_size 16MB
	}

	# Do not expose server internals; defense-in-depth headers.
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
